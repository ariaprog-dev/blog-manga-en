---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="404 - Page Not Found" description="The page you are looking for could not be found." />
		<style>
			.error-container {
				text-align: center;
				padding: 5rem 1.5rem;
				max-width: 600px;
				margin: 0 auto;
			}
			.error-icon {
				font-size: 4rem;
				margin-bottom: 1.5rem;
				display: block;
			}
			.error-code {
				font-size: 5rem;
				font-weight: 900;
				color: #6d28d9;
				margin: 0;
				line-height: 1;
				letter-spacing: -0.04em;
			}
			.error-title {
				font-size: 1.4rem;
				color: #4c1d95;
				margin: 1rem 0 1.25rem;
				font-weight: 700;
			}
			.error-message {
				font-size: 0.95rem;
				color: #71717a;
				line-height: 1.7;
				margin-bottom: 2.5rem;
			}
			.back-links {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
			}
			.back-link {
				display: inline-block;
				padding: 0.7rem 1.5rem;
				border-radius: 9999px;
				font-size: 0.9rem;
				font-weight: 700;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			.back-link-primary {
				background: #6d28d9;
				color: #ffffff;
				box-shadow: 0 2px 8px rgba(109, 40, 217, 0.2);
			}
			.back-link-primary:hover {
				background: #5b21b6;
				transform: translateY(-2px);
				box-shadow: 0 4px 12px rgba(109, 40, 217, 0.3);
			}
			.back-link-secondary {
				background: #ffffff;
				color: #6d28d9;
				border: 1.5px solid rgba(109, 40, 217, 0.25);
			}
			.back-link-secondary:hover {
				background: #f3e8ff;
				border-color: #6d28d9;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="error-container">
				<span class="error-icon">📚</span>
				<p class="error-code">404</p>
				<h1 class="error-title">Page Not Found</h1>
				<p class="error-message">
					The page you are looking for may have been moved or removed.<br />
					Please verify the URL or use one of the links below to continue browsing.
				</p>
				<div class="back-links">
					<a href="/" class="back-link back-link-primary">Back to Home</a>
					<a href="/archive/" class="back-link back-link-secondary">Browse All Articles</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
